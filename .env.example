# ==========================================
# Konfigurasi Situs Publik (Frontend)
# ==========================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME="Saluang Teknologi"
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890
NEXT_PUBLIC_COMPANY_EMAIL=kontak@saluangteknologi.com
NEXT_PUBLIC_COMPANY_ADDRESS="Padang, Sumatera Barat, Indonesia"

# ==========================================
# Konfigurasi Database (Drizzle & MySQL / TiDB Cloud)
#
# Gunakan DATABASE_URL untuk satu string koneksi:
#   - Lokal:     mysql://root:password@localhost:3306/saluang_db
#   - TiDB:      mysql://user:pass@gateway01.region.prod.aws.tidbcloud.com:4000/saluang_db
#
# Atau gunakan variabel terpisah (DB_HOST, DB_USER, dll.)
# Untuk TiDB Cloud / PlanetScale / MySQL remote yang membutuhkan SSL, set DB_SSL=true
# ==========================================
DATABASE_URL=mysql://root:password@localhost:3306/saluang_db
DB_SSL=false

# Variabel terpisah (opsional, jika tidak menggunakan DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=password
# DB_NAME=saluang_db

# ==========================================
# Konfigurasi Autentikasi (Better Auth)
# ==========================================
BETTER_AUTH_SECRET=rahasia_better_auth_placeholder_min_32_karakter
BETTER_AUTH_URL=http://localhost:3000

# Catatan Keamanan: Kredensial akun administrator (username/email dan password)
# TIDAK disimpan di dalam file .env ini demi keamanan. Seluruh akun dan kata sandi
# disimpan dalam database MySQL dan dienkripsi (scrypt hash via Better Auth).
# Gunakan CLI: npm run admin:create <email> <password> [nama]
#              npm run admin:reset-password <email> <password_baru>
#              npm run admin:list

# ==========================================
# Proteksi Spam & Keamanan (Cloudflare Turnstile)
# ==========================================
ENABLE_TURNSTILE=false
TURNSTILE_SECRET_KEY=0x4AAAAAA_placeholder_secret_key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA_placeholder_site_key

# ==========================================
# Notifikasi Tim Permintaan Proyek
# Opsi: mock | telegram | email | all (pisahkan dengan koma)
# ==========================================
NOTIFICATION_CHANNELS=mock
NOTIFICATION_EMAIL=kontak@saluangteknologi.com

# Integrasi Telegram Bot (Opsional)
TELEGRAM_BOT_TOKEN=123456789:placeholder_telegram_bot_token
TELEGRAM_CHAT_ID=-100123456789_placeholder_chat_id

# Integrasi SMTP Email (Opsional)
SMTP_HOST=smtp.mailgun.org_placeholder
SMTP_PORT=587
SMTP_USER=postmaster@placeholder.mailgun.org
SMTP_PASSWORD=placeholder_smtp_password
